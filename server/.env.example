# ---------- Server ----------
PORT=5001
NODE_ENV=development

# ---------- MongoDB ----------
# Local MongoDB:
MONGODB_URI=
# MongoDB Atlas (free tier) looks like:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/petal-and-bean?retryWrites=true&w=majority

# ---------- Auth ----------
# REQUIRED in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=12h

# Frontend origin(s) allowed to call the API (comma separated). Only needed when
# the client is served from a different origin (e.g. Vercel + Render).
CLIENT_URL=http://localhost:5173

# ---------- First-run seed (only used when the users collection is empty) ----------
AUTO_SEED=true
SEED_ADMIN_NAME=Fizza Waseem
SEED_ADMIN_EMAIL=
SEED_ADMIN_PIN=

# ---------- Shop details (shown on receipts and PDF exports) ----------
SHOP_NAME=Petal & Bean Café
SHOP_ADDRESS=12 Blossom Street
SHOP_PHONE=0300 0000000
CURRENCY=Rs.
# 0.05 = 5% tax. Set to 0 to remove tax.
TAX_RATE=0.05
